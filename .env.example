# Personal Agent - Environment Variables Template
# Copy this to .env and fill in your actual values
# NEVER commit .env to version control

# =======================
# Supabase Configuration
# =======================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here
# Optional: preferred for server-side writes on Render
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Optional alternate name supported by the app
SUPABASE_ANON_KEY=your-anon-key-here

# =======================
# Google OAuth (Gmail + Calendar)
# =======================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# =======================
# Twilio (SMS + Voice)
# =======================
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# =======================
# AI Provider
# =======================
# Choose one: groq, openrouter, openai, custom
AI_PROVIDER=groq
AI_MODEL=llama-3.1-8b-instant

# Groq
GROQ_API_KEY=your-groq-api-key

# OpenRouter
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_SITE_URL=https://your-app.example.com
OPENROUTER_APP_NAME=CINDY

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# Custom OpenAI-compatible endpoint (vLLM, TGI gateway, LocalAI, Ollama proxy, etc.)
AI_BASE_URL=http://localhost:8000/v1
AI_API_KEY=your-custom-provider-key
CUSTOM_MODEL=your-custom-model-name

# =======================
# OpenCode
# =======================
OPENCODE_API_KEY=your-opencode-api-key

# =======================
# Twenty CRM
# =======================
TWENTY_BASE_URL=https://your-twenty-instance.example.com
TWENTY_API_KEY=your-twenty-api-key
TWENTY_WORKSPACE_ID=your-twenty-workspace-id

# =======================
# Lead Generator APIs
# =======================
PROSPEO_API_KEY=pk_74f061cbc9cd30d4ca24cab35706b2dd1a0576c37b09938bc0506db2683860d0
WIZA_API_KEY=e56c288412a58188f1781588776b4fdb4f0210bf90089050917e733cd1e2d2a3
GOOGLE_PLACES_API_KEY=AIzaSyBkUVUinXY6TU7ptA7f-7Xt_az6T_X0UT8

# =======================
# CINDY Control Plane
# =======================
APP_URL=http://localhost:3000
CINDY_WORKER_SECRET=choose-a-long-random-secret
CINDY_DEFAULT_CODING_BACKEND=local-codex-bridge
CINDY_WORKER_HEARTBEAT_SECONDS=30
CINDY_WORKER_CLAIM_BATCH_SIZE=1

# Local worker bridge
CINDY_COORDINATOR_URL=http://localhost:3000
CINDY_WORKER_ID=local-coding-1
CINDY_WORKER_TYPE=coding
CINDY_WORKER_NAME=Local Codex Bridge
CINDY_WORKER_POLL_MS=5000
CINDY_CODING_COMMAND=codex
CINDY_CODING_ARGS=exec

# =======================
# Application Settings
# =======================
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# =======================
# User Configuration (for MVP)
# =======================
USER_EMAIL=your-email@gmail.com
USER_PHONE=+1234567890
USER_TIMEZONE=America/New_York
