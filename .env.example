# Personal Agent - Environment Variables Template
# Copy this to .env and fill in your actual values
# NEVER commit .env to version control

# =======================
# Supabase Configuration
# =======================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here
# Optional: preferred for server-side writes on Render
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Optional alternate name supported by the app
SUPABASE_ANON_KEY=your-anon-key-here

# =======================
# Google OAuth (Gmail + Calendar)
# =======================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# =======================
# Twilio (SMS + Voice)
# =======================
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# =======================
# AI Provider
# =======================
# Choose one: groq, openrouter, openai, custom
AI_PROVIDER=groq
AI_MODEL=llama-3.1-8b-instant

# Groq
GROQ_API_KEY=your-groq-api-key

# OpenRouter
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_SITE_URL=https://your-app.example.com
OPENROUTER_APP_NAME=CINDY

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# Custom OpenAI-compatible endpoint (vLLM, TGI gateway, LocalAI, Ollama proxy, etc.)
AI_BASE_URL=http://localhost:8000/v1
AI_API_KEY=your-custom-provider-key
CUSTOM_MODEL=your-custom-model-name

# =======================
# OpenCode
# =======================
OPENCODE_API_KEY=your-opencode-api-key

# =======================
# Application Settings
# =======================
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# =======================
# User Configuration (for MVP)
# =======================
USER_EMAIL=your-email@gmail.com
USER_PHONE=+1234567890
USER_TIMEZONE=America/New_York
