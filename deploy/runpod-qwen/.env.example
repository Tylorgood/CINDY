RUNPOD_API_KEY=replace-with-your-runpod-api-key

# Pod config
RUNPOD_POD_NAME=cindy-qwen
RUNPOD_CLOUD_TYPE=SECURE
RUNPOD_GPU_TYPE=NVIDIA RTX A4000
RUNPOD_GPU_COUNT=1
RUNPOD_PORT=8000
RUNPOD_VOLUME_GB=80
RUNPOD_CONTAINER_DISK_GB=50

# Optional: pin a datacenter if you want predictable volume locality
RUNPOD_DATACENTER_ID=

# Model config
RUNPOD_MODEL_ID=Qwen/Qwen2.5-3B-Instruct
RUNPOD_SERVED_MODEL_NAME=Qwen/Qwen2.5-3B-Instruct
RUNPOD_MAX_MODEL_LEN=8192
RUNPOD_GPU_MEMORY_UTILIZATION=0.9

# Optional, depending on model access rules
HF_TOKEN=

# Optional. If omitted, the create script will generate one for you and print it.
VLLM_API_KEY=
