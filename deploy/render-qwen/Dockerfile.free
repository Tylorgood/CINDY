FROM ghcr.io/ggml-org/llama.cpp:server

USER root

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl \
  && rm -rf /var/lib/apt/lists/*

# Bake the model into the image at build time. Render free instances have no
# persistent disk, so the GGUF must be present in the image before the service
# starts. Qwen2.5-0.5B-Instruct Q4_K_M is ~400 MB and fits the 512 MB free-tier
# RAM budget far better than the 1.5B default.
ARG MODEL_URL=https://huggingface.co/Qwen/Qwen2.5-0.5B-Instruct-GGUF/resolve/main/qwen2.5-0.5b-instruct-q4_k_m.gguf?download=true
ARG MODEL_PATH=/models/qwen2.5-0.5b-instruct-q4_k_m.gguf
ARG HF_TOKEN=""

RUN mkdir -p /models \
  && if [ -n "$HF_TOKEN" ]; then \
       curl -L --fail -H "Authorization: Bearer $HF_TOKEN" -o "$MODEL_PATH" "$MODEL_URL"; \
     else \
       curl -L --fail -o "$MODEL_PATH" "$MODEL_URL"; \
     fi \
  && test -s "$MODEL_PATH"

COPY deploy/render-qwen/start-qwen-free.sh /usr/local/bin/start-qwen-free.sh

RUN chmod +x /usr/local/bin/start-qwen-free.sh

ENTRYPOINT ["/usr/local/bin/start-qwen-free.sh"]
